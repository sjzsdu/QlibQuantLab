# ============================================================================
# QlibQuantLab 环境变量模板
#
# 用法：cp .env.example .env   然后按段落修改
# 规则：本文件只放占位符与开发默认值，真实密钥永不提交到仓库（见 .gitignore）
# 两套 compose 都读取同一个 .env：
#   docker-compose.yml       模式 A · 自包含（在 compose 内起全套依赖）
#   docker-compose.prod.yml  模式 B · 复用已有基础设施（地址由本文件指向外部实例）
#
# 标记 [必填] 的变量缺一个后端就拒绝启动；[生产必改] 的变量在 APP_ENV=production
# 时会触发启动校验，不合规直接抛 ConfigError。
# ============================================================================

# ----------------------------------------------------------------------------
# 1 · 应用通用
# ----------------------------------------------------------------------------
APP_ENV=development            # development | production | test
LOG_LEVEL=INFO
IS_WORKER=false                # worker 容器里由 compose 置为 true

# [必填] 数据库（异步驱动）
DATABASE_BACKEND=postgres      # postgres | sqlite
DATABASE_URL=postgresql+asyncpg://qqlab:qqlab-dev-secret@postgres:5432/qqlab
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false
# 仅模式 A 使用的本地 Postgres 账号
POSTGRES_USER=qqlab
POSTGRES_PASSWORD=qqlab-dev-secret
POSTGRES_DB=qqlab

# [必填] 缓存
# 开发环境这台 Redis 不设密码 —— Qlib-Server 官方实现不支持 Redis 密码
# （qlib_server/utils.py: redis.StrictRedis(host, port, db) 无 password 参数），
# 共用实例只能免密，靠 Docker 内网隔离；生产建议应用与 Qlib-Server 各用一个实例。
CACHE_BACKEND=redis            # redis | memory（memory 仅用于本机测试）
CACHE_URL=redis://redis:6379/5

# [必填] 消息队列
MQ_BACKEND=rabbitmq            # rabbitmq | memory
MQ_URL=amqp://qqlab:qqlab-dev-secret@rabbitmq:5672/%2Fqqlab
MQ_PREFETCH=1
RABBITMQ_DEFAULT_USER=qqlab
RABBITMQ_DEFAULT_PASS=qqlab-dev-secret

# 对象存储：local（开发/单机，零依赖，默认）| minio | s3
# 当前环境拉不到 minio 镜像（Docker Hub 已移除 minio/minio，quay 与国内代理亦失败），
# 所以默认 local：docker compose up 不需要任何对象存储服务，数据落在 objects_data 卷。
# 拿到可用镜像源后恢复 minio 的三步：
#   1) 本文件改 STORAGE_BACKEND=minio
#   2) 需要时给 docker daemon 配 registry mirror（或改用自建/内网镜像）
#   3) docker compose --profile minio up -d minio
#   bucket 由 backend 启动时惰性创建，无需 mc 初始化容器。
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/objects
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_BUCKET=qqlab
STORAGE_S3_ACCESS_KEY=qqlab
STORAGE_S3_SECRET_KEY=qqlab-dev-secret
STORAGE_S3_PATH_STYLE=true
MINIO_ROOT_USER=qqlab
MINIO_ROOT_PASSWORD=qqlab-dev-secret

# 认证（阶段 1-6 用 mock；阶段 7 改成 casdoor —— 只改环境变量，不动代码）
AUTH_PROVIDER=mock             # [生产必改] production 下禁止 mock
APP_JWT_SECRET=dev-only-not-secret-change-me-0123456789abcdef   # [生产必改] >=32 字节随机值
APP_JWT_TTL_SECONDS=28800
SESSION_COOKIE_NAME=qqlab_session
SESSION_COOKIE_SECURE=false    # [生产必改] true（HTTPS）
CSRF_COOKIE_NAME=qqlab_csrf
CORS_ALLOW_ORIGINS=http://localhost:3000   # [必填] 逗号分隔，[生产必改]

# Mock 身份（仅 AUTH_PROVIDER=mock 生效）
MOCK_USER_ID=dev-user
MOCK_USER_USERNAME=dev
MOCK_USER_DISPLAY_NAME=Dev User
MOCK_USER_EMAIL=dev@qlibquantlab.local
MOCK_ORG_ID=dev-org
MOCK_ORG_SLUG=dev
MOCK_ORG_NAME=Dev Organization
MOCK_USER_ROLES=admin,researcher

# Casdoor（阶段 7 切 AUTH_PROVIDER=casdoor 时必填 —— 缺一项后端启动即拒绝）
# dev 快速起法：
#   docker compose --profile casdoor up -d casdoor   # 宿主 8001 → 容器 8000
#   # 种子无需手动执行：deploy/casdoor/init_data.json 已挂载，casdoor 启动时幂等应用（docs/stage7/05）
#   #   org=qqlab / 应用=qqlab-dev-client / secret=qqlab-dev-secret-0123456789abcdef / 4 个 smoke 用户
# 把下面四要素填成种子固定值（或改指你的 IdP）；dev 双地址拓扑（D7-7）：
#   浏览器可达走 ISSUER（宿主映射端口），后端容器可达走 INTERNAL_URL（compose 服务名）
CASDOOR_ISSUER=                 # 浏览器可达 OIDC 地址，例 http://localhost:8001（dev）/ https://idp.example.com（生产）
CASDOOR_INTERNAL_URL=           # 后端容器可达地址（dev 例 http://casdoor:8000）；生产与 ISSUER 相同时留空
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_REDIRECT_URI=           # 必须与 Casdoor 应用 RedirectUrls 一致：{前端源}/api/v1/auth/callback
CASDOOR_SCOPES=openid profile email
CASDOOR_ROLE_CLAIM=roles        # claim 名默认即可（Casdoor JWT 内嵌 user struct 的 roles 字段）
CASDOOR_ORG_ID_CLAIM=owner      # 组织取 JWT 的 owner 字段（org 名，零 Casdoor 侧配置；D7-2）
CASDOOR_ROLE_MAP={}             # JSON：Casdoor 角色名 → 平台角色；映射后为空/未知 → 拒绝登录（fail-closed）
CASDOOR_ORG_MAP={}              # JSON：Casdoor 组织名 → 平台 org_id；留空直通 claim 原值
HOST_PORT_CASDOOR=8001          # 宿主映射端口（仅 --profile casdoor 时使用）

# ----------------------------------------------------------------------------
# 2 · Qlib 计算（API 进程永不 import qlib；只有 worker 容器跑计算）
# ----------------------------------------------------------------------------
# [必填] 计算后端：stub（默认，合成数据/模拟器，零外部依赖）| qlib（真实数据，经 Qlib-Server）
# 阶段 3 smoke：先 stub 全链路，再 --profile qlib 起 Qlib-Server 后切 qlib
COMPUTE_BACKEND=stub

# [必填] 后端是 Qlib-Server 的 WebSocket 客户端
QLIB_SERVER_WS_URL=ws://qlib-server:9710
QLIB_DATA_ROOT=/qlib_data
QLIB_DATA_SUBDIR=cn_data          # dump_bin 根目录名（provider_uri = {root}/{org}/{subdir}）
# 0 = 全量；填数字 N = 只导入/回测前 N 个标的（首次 smoke 用小集合）
# 注意：值必须非空 —— compose 对「空值 + 行内注释」不剥离注释，会把 # 注释当值传给容器
QLIB_DATA_SYMBOLS=0
QLIB_EXPERIMENT_ROOT=/experiments
QLIB_REGION=cn
QLIB_WORKER_CONCURRENCY=1      # qlib 是进程单例，必须为 1
QLIB_INIT_TIMEOUT_SECONDS=60
WORKER_STALE_JOB_MINUTES=10    # R6-2：worker 启动时回收孤儿 running 任务的心跳阈值（单副本前提，见 06-risks）

# Qlib-Server 自身的硬依赖（Redis + RabbitMQ 必填，不可省略、不可换实现）
QLIB_SERVER_REDIS_HOST=redis
QLIB_SERVER_REDIS_PORT=6379
QLIB_SERVER_REDIS_DB=0
QLIB_SERVER_QUEUE_HOST=rabbitmq
QLIB_SERVER_QUEUE_PORT=5672
QLIB_SERVER_QUEUE_USER=qqlab
QLIB_SERVER_QUEUE_PASS=qqlab-dev-secret
QLIB_SERVER_TASK_QUEUE=task_queue
QLIB_SERVER_MESSAGE_QUEUE=message_queue
QLIB_SERVER_PLATFORM=linux/amd64   # Apple Silicon 走 Rosetta/QEMU；arm64 自建镜像后置空
# worker 同样锁 amd64：pyqlib 0.9.7 只有 manylinux2014_x86_64 wheel（无 arm64 / 无 sdist）
WORKER_PLATFORM=linux/amd64

# ----------------------------------------------------------------------------
# 3 · 限流 / 审计 / 合规
# ----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_WRITE_PER_MIN=120
RATE_LIMIT_READ_PER_MIN=600
AUDIT_RETENTION_DAYS=365

# ----------------------------------------------------------------------------
# 4 · 前端（浏览器只用相对路径 /api，这些地址只在服务端生效）
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE=/api
BACKEND_INTERNAL_URL=http://backend:8000   # next.config.ts 的 rewrite 目标

# ----------------------------------------------------------------------------
# 4b · 宿主端口（模式 A，均可覆盖；默认避开本机常见的 5432 / 6379）
#      容器之间恒走服务名与内部端口（postgres:5432、redis:6379…），只有这里改宿主映射
# ----------------------------------------------------------------------------
HOST_PORT_WEB=3000            # 前端
HOST_PORT_API=8000            # 后端 API
HOST_PORT_PG=5433             # Postgres（127.0.0.1 回环）
HOST_PORT_REDIS=16379         # Redis（127.0.0.1 回环）
HOST_PORT_AMQP=5672           # RabbitMQ
HOST_PORT_AMQP_MGMT=15672     # RabbitMQ 管理台
HOST_PORT_S3=9000             # MinIO S3（--profile minio 才生效）
HOST_PORT_S3_CONSOLE=9001     # MinIO 控制台
HOST_PORT_QLIB=9710           # Qlib-Server（--profile qlib 才生效）
HOST_PORT_PROMETHEUS=9090     # Prometheus（--profile monitor 才生效，127.0.0.1 回环）
HOST_PORT_ALERTMANAGER=9093   # Alertmanager（阶段 9 · D 项，--profile monitor）
HOST_PORT_GRAFANA=3100        # Grafana（阶段 9 · D 项；admin / GRAFANA_ADMIN_PASSWORD）
HOST_PORT_NOTIFY_BRIDGE=9094  # 告警通知桥 /healthz 与 /receipts（阶段 9 · D 项）

# 告警通知通道（阶段 9 · D 项 —— 接口+配置驱动：Alertmanager → notify-bridge → 通道扇出）
# 留空的通道不启用；全部留空时告警只落 bridge 的本地 sink（docker exec / 卷内 JSON 回执）。
# 生产建议至少配一个真实通道（企微/钉钉/飞书 webhook 或 SMTP 邮件）：
# NOTIFY_WECOM_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# NOTIFY_DINGTALK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
# NOTIFY_DINGTALK_SECRET=SECxxx          # 加签密钥（可选）
# NOTIFY_FEISHU_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# NOTIFY_EMAIL_HOST=smtp.example.com
# NOTIFY_EMAIL_PORT=587
# NOTIFY_EMAIL_USER=
# NOTIFY_EMAIL_PASSWORD=
# NOTIFY_EMAIL_FROM=qqlab-alert@example.com
# NOTIFY_EMAIL_TO=oncall@example.com,backup@example.com
# GRAFANA_ADMIN_PASSWORD=qqlab-grafana-dev   # 生产必须改

# ----------------------------------------------------------------------------
# 5 · 生产 / 模式 B 专用（docker-compose.prod.yml 的 labels 读取）
# ----------------------------------------------------------------------------
# 反向代理只出现在 compose 层，应用代码完全不感知
TRAEFIK_HOST_WEB=
TRAEFIK_HOST_API=
TRAEFIK_HOST_QLIB=
TRAEFIK_CERT_RESOLVER=letsencrypt
EXTERNAL_TRAEFIK_NETWORK=traefik-net

# 进程数
BACKEND_WORKERS=4
WORKER_REPLICAS=1

# 资源限额（阶段 9 · B 项；prod compose 有默认值，不填也能起）
# BACKEND_MEM_LIMIT=2g
# WORKER_MEM_LIMIT=8g        # qlib 训练/回测峰值大；OOM 会表现为 worker 心跳丢失告警
# FRONTEND_MEM_LIMIT=1g
# QLIB_SERVER_MEM_LIMIT=2g

# 复用外部基础设施时：把上面的 DATABASE_URL / CACHE_URL / MQ_URL / STORAGE_S3_*
# 直接改成外部实例地址即可，模式 B 的 compose 不再起本地依赖服务。

# ----------------------------------------------------------------------------
# 6 · 镜像发布与生产拉取（阶段 9 · A 项）
#    构建推送：scripts/build_push_images.sh（TAG 默认 = sha-<git 短 sha>，镜像与提交绑定）
#    部署拉取：IMAGE_TAG=<sha-xxx> docker compose -f docker-compose.prod.yml pull
#    回滚：deploy/image-manifest.json 里存着每次发布的 tag + digest，换回上一份即可
# ----------------------------------------------------------------------------
# IMAGE_PREFIX=sjzsdu     # Docker Hub 命名空间（或 registry.example.com/namespace）
# IMAGE_TAG=latest        # 生产侧拉取用的 tag；正式发布用 sha-<git> 不用 latest
