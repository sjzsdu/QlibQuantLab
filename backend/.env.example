# 本机开发用（不走 Docker）：sqlite + memory 适配器，零外部依赖
# 用法：cd backend && cp .env.example .env
# 连 Postgres/Redis/RabbitMQ/MinIO 请改用仓库根目录的 .env + docker compose（模式 A）。

APP_ENV=development
LOG_LEVEL=INFO
IS_WORKER=false

# ---- 数据库：本地 sqlite 文件（与生产同构，仅驱动不同）----
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_ECHO=false

# ---- 缓存 / 队列 / 存储：内存实现（真实实现见 adapter 契约测试）----
CACHE_BACKEND=memory
CACHE_URL=memory://
MQ_BACKEND=memory
MQ_URL=memory://
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/objects

# ---- 认证（开发用 mock；生产必须 casdoor）----
AUTH_PROVIDER=mock
APP_JWT_SECRET=dev-only-not-secret-change-me-0123456789abcdef
APP_JWT_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
CORS_ALLOW_ORIGINS=http://localhost:3000

# ---- Qlib（本机没起 Qlib-Server 时仅影响 worker 的在线任务）----
QLIB_SERVER_WS_URL=ws://localhost:9710
QLIB_SERVER_REDIS_HOST=localhost
QLIB_SERVER_QUEUE_HOST=localhost
