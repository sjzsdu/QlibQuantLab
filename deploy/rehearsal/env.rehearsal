# env.rehearsal —— 阶段 9 演练的 compose **插值变量**（--env-file deploy/rehearsal/env.rehearsal）。
#
# 作用域：只影响 `docker compose --env-file …` 的 ${VAR} 插值；容器运行时 env 由
# docker-compose.prod.yml 的 env_file: [.env] + docker-compose.prod-rehearsal.yml 的
# environment: 覆盖共同决定 —— **仓库 .env 一行不改**。
#
# 占位域名：未提供真实域名/证书前用 *.rehearsal.test（本机 /etc/hosts 或 curl --resolve
# 指到 127.0.0.1）；拿到真实值后只改本文件与证书，链路零改动。

# 演练网络（infra-sim 与 prod 栈的公共外部网络；脚本会 docker network create）
REHEARSAL_NETWORK=qqlab-prod-rehearsal-traefik
EXTERNAL_TRAEFIK_NETWORK=qqlab-prod-rehearsal-traefik

# 占位域名（Host 路由；真实部署 = 真实域名）
TRAEFIK_HOST_WEB=app.rehearsal.test
TRAEFIK_HOST_API=api.rehearsal.test
TRAEFIK_HOST_QLIB=qlib.rehearsal.test
TRAEFIK_CERT_RESOLVER=rehearsal-placeholder # 对应 traefik.prod-rehearsal.yml 的占位 resolver

# 镜像：与 scripts/build_push_images.sh 的产物对齐（tag 绑定 git 提交）。
# 优先级：shell 环境 IMAGE_TAG > 本文件 —— scripts/rehearsal_up.sh 会从
# deploy/image-manifest.json 读 tag 并 export，故走脚本时**本行被覆盖**；
# 只有直接 `docker compose --env-file …` 调用才用到本行（当前演练栈运行中的 tag，
# 与 image-manifest.json 同值）。发版后对账/更新方式见 docs/stage9/02。
IMAGE_PREFIX=sjzsdu
IMAGE_TAG=sha-185797d0e404-dirty

# 演练资源（内存敏感机器调小；默认值见 docker-compose.prod.yml）
BACKEND_WORKERS=2

# worker / qlib-server 锁 amd64（pyqlib 0.9.7 无 arm64 wheel；Apple Silicon 走 Rosetta）
WORKER_PLATFORM=linux/amd64
QLIB_SERVER_PLATFORM=linux/amd64
