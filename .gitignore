# --- 环境与密钥（真实值永不入库；.env.example 才入库）---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# --- Node ---
node_modules/
.next/
out/
*.tsbuildinfo

# --- 运行期数据 ---
# 逻辑备份产物（scripts/backup.sh）—— dump 含业务数据，不入库
backups/
# 镜像发布清单（scripts/build_push_images.sh 生成）—— 每次构建产物，发版记录进 docs/stage9/02
deploy/image-manifest.json
# 演练自签证书（scripts/rehearsal_up.sh 生成，含私钥）—— 永不入库
deploy/rehearsal/certs/
# 工具项目标识（外部工具生成，非仓库内容）
.freebuff/
# 本地对象存储（STORAGE_BACKEND=local）
# 注意：`data/` 会误伤前端路由目录 frontend/src/app/data/，显式放行
data/
!frontend/src/app/data/
*.db
*.sqlite3

# --- 日志与编辑器 ---
*.log
logs/
.DS_Store
.idea/
.vscode/
.workbuddy
